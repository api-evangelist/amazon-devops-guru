{
  "opencollection": "1.0.0",
  "info": {
    "name": "Amazon DevOps Guru Accounts Anomalies API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Anomalies",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "DescribeAnomaly",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://devops-guru.{region}.amazonaws.com/anomalies/:Id",
            "headers": [
              {
                "name": "X-Amz-Content-Sha256",
                "value": ""
              },
              {
                "name": "X-Amz-Date",
                "value": ""
              },
              {
                "name": "X-Amz-Algorithm",
                "value": ""
              },
              {
                "name": "X-Amz-Credential",
                "value": ""
              },
              {
                "name": "X-Amz-Security-Token",
                "value": ""
              },
              {
                "name": "X-Amz-Signature",
                "value": ""
              },
              {
                "name": "X-Amz-SignedHeaders",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "Id",
                "value": "",
                "type": "path",
                "description": " The ID of the anomaly. "
              },
              {
                "name": "AccountId",
                "value": "",
                "type": "query",
                "description": "The ID of the member account."
              }
            ]
          },
          "docs": " Returns details about an anomaly that you specify using its ID. "
        },
        {
          "info": {
            "name": "ListAnomaliesForInsight",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://devops-guru.{region}.amazonaws.com/anomalies/insight/:InsightId",
            "headers": [
              {
                "name": "X-Amz-Content-Sha256",
                "value": ""
              },
              {
                "name": "X-Amz-Date",
                "value": ""
              },
              {
                "name": "X-Amz-Algorithm",
                "value": ""
              },
              {
                "name": "X-Amz-Credential",
                "value": ""
              },
              {
                "name": "X-Amz-Security-Token",
                "value": ""
              },
              {
                "name": "X-Amz-Signature",
                "value": ""
              },
              {
                "name": "X-Amz-SignedHeaders",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "InsightId",
                "value": "",
                "type": "path",
                "description": " The ID of the insight. The returned anomalies belong to this insight. "
              },
              {
                "name": "MaxResults",
                "value": "",
                "type": "query",
                "description": "Pagination limit"
              },
              {
                "name": "NextToken",
                "value": "",
                "type": "query",
                "description": "Pagination token"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": " Returns a list of the anomalies that belong to an insight that you specify using its ID. "
        }
      ]
    }
  ],
  "bundled": true
}